  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action: ink fill, 11px radius, 46px tall; lifts 1px on hover.",
      "html": "<a class=\"ds-btn-primary\" href=\"#\">Get started <svg width=\"18\" height=\"10\" viewBox=\"0 0 22 12\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M1 6h19M15 1l5 5-5 5\"/></svg></a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:10px;height:46px;padding:0 20px;border-radius:11px;font:500 0.98rem Geist,ui-sans-serif,system-ui,sans-serif;letter-spacing:-0.005em;text-decoration:none;background:#0c0d14;color:#fff;border:1px solid transparent;transition:background .2s cubic-bezier(0.16,1,0.3,1),transform .2s cubic-bezier(0.16,1,0.3,1)}.ds-btn-primary:hover{background:#1e1f2c;transform:translateY(-1px)}.ds-btn-primary:focus-visible{outline:2px solid #3b6cf6;outline-offset:3px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Companion action: card fill with a Rule border.",
      "html": "<a class=\"ds-btn-secondary\" href=\"#\">View on GitHub</a>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:10px;height:46px;padding:0 20px;border-radius:11px;font:500 0.98rem Geist,ui-sans-serif,system-ui,sans-serif;text-decoration:none;background:#fff;color:#0c0d14;border:1px solid #d3d4e0;transition:border-color .2s,transform .2s cubic-bezier(0.16,1,0.3,1)}.ds-btn-secondary:hover{border-color:#6b6e82;transform:translateY(-1px)}.ds-btn-secondary:focus-visible{outline:2px solid #3b6cf6;outline-offset:3px}"
    },
    {
      "name": "Command Block",
      "kind": "custom",
      "refersTo": "command-block",
      "description": "A real command in Geist Mono with a copy button; the site's workhorse.",
      "html": "<div class=\"ds-cmd\"><pre>curl -fsSL https://raw.githubusercontent.com/TonmoyTalukder/werkz/main/install.sh | sh</pre><button class=\"ds-copy\" type=\"button\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"><rect x=\"8\" y=\"8\" width=\"12\" height=\"12\" rx=\"2.5\"/><path d=\"M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8\"/></g></svg>Copy</button></div>",
      "css": ".ds-cmd{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:8px;background:#f3f3f7;border:1px solid #e6e6ee;border-radius:10px}.ds-cmd pre{margin:0;padding:13px 4px 13px 15px;white-space:pre-wrap;font:400 0.88rem/1.6 'Geist Mono',ui-monospace,Menlo,monospace;color:#0c0d14}.ds-copy{display:inline-flex;align-items:center;gap:6px;height:30px;margin:7px 7px 0 0;padding:0 10px;border-radius:8px;border:1px solid #d3d4e0;background:#fff;color:#4a4c5e;font:500 0.8rem Geist,ui-sans-serif,sans-serif;cursor:pointer;transition:color .2s,border-color .2s}.ds-copy:hover{color:#0c0d14;border-color:#6b6e82}.ds-copy:focus-visible{outline:2px solid #3b6cf6;outline-offset:3px}"
    },
    {
      "name": "Install Tabs",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Horizontal tabs: ink-3 labels, selected gets ink and a 2px blue underline.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">Linux &amp; macOS</button><button role=\"tab\" aria-selected=\"false\">Homebrew</button><button role=\"tab\" aria-selected=\"false\">apt</button></div>",
      "css": ".ds-tabs{display:flex;gap:4px;padding:8px 8px 0;border-bottom:1px solid #e6e6ee}.ds-tabs button{appearance:none;border:0;background:transparent;cursor:pointer;padding:9px 12px 11px;font:500 0.9rem Geist,ui-sans-serif,sans-serif;color:#6b6e82;border-bottom:2px solid transparent;margin-bottom:-1px;transition:color .2s,border-color .2s}.ds-tabs button:hover{color:#0c0d14}.ds-tabs button[aria-selected=true]{color:#0c0d14;border-bottom-color:#3b6cf6}.ds-tabs button:focus-visible{outline:2px solid #3b6cf6;outline-offset:3px;border-radius:6px}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Quiet ink-2 links with 8px-radius Mist hover pills; current page uses the hover state.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Docs</a><a href=\"#\">Install</a><a href=\"#\">Subscriptions</a><a href=\"#\">Releases</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px}.ds-nav a{color:#4a4c5e;font:400 0.94rem Geist,ui-sans-serif,sans-serif;padding:7px 12px;border-radius:8px;text-decoration:none;transition:color .2s,background .2s}.ds-nav a:hover,.ds-nav a[aria-current=page]{color:#0c0d14;background:#f6f6f9}.ds-nav a:focus-visible{outline:2px solid #3b6cf6;outline-offset:3px}"
    },
    {
      "name": "Provider Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Full-round chip; subscription chips tint the border toward blue.",
      "html": "<span class=\"ds-chip\">Ollama</span> <span class=\"ds-chip ds-chip-plan\">ChatGPT plan</span>",
      "css": ".ds-chip{display:inline-block;padding:7px 14px;border-radius:999px;border:1px solid #e6e6ee;background:#fff;color:#4a4c5e;font:500 0.92rem Geist,ui-sans-serif,sans-serif}.ds-chip-plan{border-color:color-mix(in srgb,#3b6cf6 35%,#e6e6ee);color:#0c0d14}"
    },
    {
      "name": "Status Pill",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Permission state: dot plus tinted wash; green allowed, amber asks, red blocked.",
      "html": "<span class=\"ds-pill ds-yes\">Allowed</span> <span class=\"ds-pill ds-ask\">Asks</span> <span class=\"ds-pill ds-no\">Blocked</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:999px;font:500 0.82rem Geist,ui-sans-serif,sans-serif}.ds-pill::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}.ds-yes{color:#15803d;background:color-mix(in srgb,#16a34a 12%,transparent)}.ds-ask{color:#b45309;background:color-mix(in srgb,#ff9933 18%,transparent)}.ds-no{color:#e8344e;background:color-mix(in srgb,#e8344e 11%,transparent)}"
    },
    {
      "name": "Doc Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat bordered link card that lifts 2px and gains the Rest shadow on hover.",
      "html": "<a class=\"ds-card\" href=\"#\"><span><b>Getting started</b><span>Install, pick a model and run your first task.</span></span><svg width=\"22\" height=\"12\" viewBox=\"0 0 22 12\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M1 6h19M15 1l5 5-5 5\"/></svg></a>",
      "css": ".ds-card{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;max-width:340px;padding:18px 18px 18px 20px;border-radius:14px;border:1px solid #e6e6ee;background:#fff;color:#0c0d14;text-decoration:none;font-family:Geist,ui-sans-serif,sans-serif;transition:border-color .2s,box-shadow .2s,transform .2s cubic-bezier(0.16,1,0.3,1)}.ds-card b{display:block;font-weight:600;margin-bottom:4px}.ds-card span span{display:block;font-size:0.9rem;color:#4a4c5e;line-height:1.5}.ds-card svg{margin-top:6px;color:#6b6e82;transition:transform .2s,color .2s}.ds-card:hover{border-color:#d3d4e0;box-shadow:0 1px 2px rgba(12,13,20,.05),0 4px 10px -6px rgba(12,13,20,.12);transform:translateY(-2px)}.ds-card:hover svg{transform:translateX(3px);color:#0c0d14}.ds-card:focus-visible{outline:2px solid #3b6cf6;outline-offset:3px}"
    },
    {
      "name": "Product Window",
      "kind": "custom",
      "refersTo": "product-window",
      "description": "Dark window frame over the single brand glow; holds the real werkz TUI capture.",
      "html": "<figure class=\"ds-shot\"><div class=\"ds-window\"><div class=\"ds-bar\"><i style=\"background:#ff9933\"></i><i style=\"background:#e8344e\"></i><i style=\"background:#3b6cf6\"></i><span>~/code/my-app — werkz</span></div><div class=\"ds-screen\"></div></div></figure>",
      "css": ".ds-shot{position:relative;margin:40px;max-width:560px}.ds-shot::before{content:'';position:absolute;inset:-6% -5% -8%;background:linear-gradient(100deg,#ff9933 0%,#e8344e 48%,#3b6cf6 100%);filter:blur(64px);opacity:.7;border-radius:40%}.ds-window{position:relative;border-radius:16px;overflow:hidden;background:#0c0d14;border:1px solid rgba(12,13,20,.14);box-shadow:0 2px 6px rgba(12,13,20,.06),0 30px 60px -30px rgba(12,13,20,.35)}.ds-bar{display:flex;align-items:center;gap:8px;height:40px;padding:0 16px;background:#1e1f2c;color:#a4a6b8;font:500 0.82rem Geist,ui-sans-serif,sans-serif;border-bottom:1px solid rgba(255,255,255,.06)}.ds-bar i{width:11px;height:11px;border-radius:50%}.ds-bar span{margin:0 auto}.ds-screen{height:220px}"
